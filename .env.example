# ===============================================
# JARVIS AI Orchestrator Configuration
# ===============================================

# Neural LLM Providers (Configure at least one)
GROQ_API_KEY=gsk_your_groq_key_here
GEMINI_API_KEY=your_gemini_api_key_here
NVIDIA_API_KEY=nvapi_your_nvidia_key_here

# Active Provider: auto (prefers Groq for speed), groq, gemini, nvidia
ACTIVE_PROVIDER=auto

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Discord Bot Token & Client ID (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here

# Persistent storage file path
DATA_PATH=./data/jarvis_store.json

# Default user ID for CLI interactions
DEFAULT_USER_ID=primary_user

# Web Dashboard Port
PORT=3001

# Log level (debug, info, warn, error)
LOG_LEVEL=info
